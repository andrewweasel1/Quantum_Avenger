{
  "sandbox": {
    "network": {
      "allowedDomains": [
        "paper-api.alpaca.markets",
        "data.alpaca.markets"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(./reference_code/**)",
      "Write(./reference_code/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
