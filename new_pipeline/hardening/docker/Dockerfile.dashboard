# Quantum Avenger — Streamlit dashboard image (Phase 7).
#   docker build -f new_pipeline/hardening/docker/Dockerfile.dashboard -t quantum-avenger-dashboard .
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY new_pipeline/requirements.txt new_pipeline/requirements-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dashboard.txt

COPY new_pipeline ./new_pipeline

RUN useradd --create-home --uid 10001 quant && chown -R quant /app
USER quant

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "new_pipeline/monitoring/dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
